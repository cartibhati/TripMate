# Primary LLM (Google Gemini - recommended for high TPM, speed & reliability)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM
GROQ_API_KEY=your_groq_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DEFAULT_ORIGIN_IATA=IND
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=TripMate


# Weather is now powered by open-meteo-mcp-server (free, no API key needed)
# OPENWEATHER_API_KEY is no longer required

